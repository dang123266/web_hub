---
import Base from '../layouts/Base.astro';
import CollectionSearch from '../components/CollectionSearch.astro';
import { getModules, getModulePages, getItems, plainItem, fileUrl, withBase } from '../lib/modules.js';

export function getStaticPaths() {
  const out = [];
  for (const m of getModules()) {
    const route = m.route.replace(/^\/|\/$/g, '');
    const items = m.collection ? getItems(m.dir) : [];
    for (const p of getModulePages(m.dir)) {
      const slug = p.file === 'index' ? route : `${route}/${p.file}`;
      out.push({ params: { slug }, props: { kind: p.file === 'index' && m.collection ? 'collection' : 'page', page: p, mod: m, items: items.map(plainItem) } });
    }
    for (const it of items) {
      out.push({ params: { slug: `${route}/${it.id}` }, props: { kind: 'item', item: it, mod: m } });
    }
  }
  return out;
}
const { kind, page, mod, items, item } = Astro.props;
const title = kind === 'item' ? item.title : (page.frontmatter?.title ?? mod.name);
const description = kind === 'item' ? item.summary : page.frontmatter?.summary;
const Content = kind === 'item' ? item.Content : page.Content;
---
<Base title={title} description={description}>
  {kind === 'item' ? (
    <article class="item-view">
      <p class="item-back"><a href={withBase(mod.route)}>← Quay lại {mod.name}</a></p>
      <h1>{item.title}</h1>
      <div class="result-meta">
        {[item.type, item.date].filter(Boolean).join(' · ')}
        {item.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      {item.files.length > 0 ? (
        <div class="item-files">
          {item.files.map((f, i) => (
            <div class="item-file">
              <a class={i === 0 ? 'button' : 'button button-secondary'} href={fileUrl(f.url)}>{f.label ?? 'Tải về'}{f.size ? ` (${f.size})` : ''}</a>
              {f.sha256 && <details class="item-sha"><summary>Mã kiểm tra sha256</summary><code>{f.sha256}</code></details>}
            </div>
          ))}
        </div>
      ) : <p class="empty-note">Mục này chưa có file đính kèm.</p>}
      <Content />
    </article>
  ) : (
    <article>
      <Content />
      {kind === 'collection' && <CollectionSearch items={items} route={mod.route} label={mod.collection.label ?? 'mục'} />}
    </article>
  )}
</Base>
